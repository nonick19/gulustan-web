---
import SectionTitle from './SectionTitle.astro'
import { ui } from '../i18n/ui.js'

const { lang = 'tr' } = Astro.props
const t = ui[lang].about
---

<section id="about" class="py-20 md:py-28">
  <div class="shell">
    <SectionTitle num={t.num} title={t.title} />

    <div class="grid gap-8 lg:grid-cols-[1.6fr_1fr] lg:gap-14" data-reveal>
      <div class="max-w-[560px] space-y-5 text-[1.02rem] leading-relaxed text-base-content/60">
        {t.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <aside class="h-fit rounded-2xl border border-white/5 bg-base-200/40 p-6">
        <h3 class="text-xs font-semibold uppercase tracking-[0.2em] text-base-content/55">
          {t.focusTitle}
        </h3>
        <ul class="mt-4 space-y-3 text-sm">
          {
            t.focus.map(([title, desc]) => (
              <li class="border-t border-white/5 pt-3 first:border-t-0 first:pt-0">
                <p class="font-semibold text-base-content">{title}</p>
                <p class="mt-0.5 text-base-content/55">{desc}</p>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>