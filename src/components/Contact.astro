---
import SectionTitle from './SectionTitle.astro'
import { contactChannels, ui } from '../i18n/ui.js'

const { lang = 'tr' } = Astro.props
const t = ui[lang].contact

const icons = {
  phone:
    'M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z',
  chat:
    'M21 11.5a8.4 8.4 0 0 1-9 8.4 8.9 8.9 0 0 1-4-.9L3 21l1.9-4.6a8.4 8.4 0 0 1-.9-4 8.4 8.4 0 0 1 8.5-8.4A8.4 8.4 0 0 1 21 11.5Z',
  plane: 'M21 3 3 10.5l6 2.5m12-10-5.5 18L10 13m11-10L10 13',
  mail: 'M3 5h18v14H3zM3 7l9 6 9-6',
}
---

<section id="contact" class="py-20 md:py-28">
  <div class="shell">
    <SectionTitle num={t.num} title={t.title} lead={t.lead} />

    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        contactChannels.map((channel) => (
          <a
            href={channel.href}
            target={channel.external ? '_blank' : undefined}
            rel={channel.external ? 'noopener noreferrer' : undefined}
            data-reveal
            class="card border border-white/5 bg-base-200/40 p-5 transition duration-300 hover:-translate-y-1 hover:border-primary/40 hover:bg-base-200/70"
          >
            <span class="mb-3 inline-flex h-10 w-10 items-center justify-center rounded-xl border border-secondary/20 bg-secondary/10 text-secondary">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="h-5 w-5"
                aria-hidden="true"
              >
                <path d={icons[channel.icon]} />
              </svg>
            </span>
            <span class="font-semibold">{channel[lang].title}</span>
            <span class="mt-0.5 text-sm text-base-content/55">{channel[lang].value}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>