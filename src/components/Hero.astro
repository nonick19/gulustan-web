---
import { ui } from '../i18n/ui.js'

const { lang = 'tr' } = Astro.props
const t = ui[lang].hero
---

<section id="hero" class="relative flex min-h-screen items-center overflow-hidden">
  {/* Düz, keskin kenarlı malzeme vurgusu (bulanık hale değil). */}
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-28 top-1/2 h-[32rem] w-[32rem] -translate-y-1/2 rounded-full bg-primary/[0.08] lg:h-[44rem] lg:w-[44rem]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute right-16 top-1/2 hidden h-[26rem] w-[26rem] -translate-y-1/2 rounded-full border border-secondary/15 lg:block"
  >
  </div>

  <div class="hero__canvas" data-hero-scene aria-hidden="true"></div>

  <div class="pointer-events-none relative z-10 shell pb-24 pt-32">
    <p class="mb-3 font-mono text-sm tracking-[0.18em] text-secondary">{t.eyebrow}</p>
    <h1 class="text-5xl font-bold leading-[1.05] tracking-tight text-base-content sm:text-6xl lg:text-7xl">
      Ali Gülüstan
    </h1>
    <h2 class="mt-4 text-xl font-semibold sm:text-2xl">
      {t.role} <span class="mx-2 text-primary">/</span>
      {t.roleAlt}
    </h2>
    <p class="mt-5 max-w-xl text-base leading-relaxed text-base-content/60 sm:text-lg">
      {t.desc}
    </p>

    <div class="pointer-events-auto mt-8 flex flex-wrap gap-3">
      <a href="#projects" class="btn btn-primary">{t.ctaPrimary}</a>
      <a href="#contact" class="btn btn-outline btn-secondary">{t.ctaSecondary}</a>
    </div>
  </div>

  <a
    href="#about"
    aria-label={t.scroll}
    class="hero__scroll absolute bottom-7 left-1/2 z-10 flex h-11 w-7 -translate-x-1/2 justify-center rounded-full border-2 border-base-content/30 transition-colors hover:border-secondary"
  >
    <span class="mt-2 h-2 w-1 rounded-full bg-secondary"></span>
  </a>
</section>

<script>
  const mount = document.querySelector('[data-hero-scene]')
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches
  if (mount && !reduced) {
    // three.js yalnızca gerektiğinde yüklenir.
    import('../scripts/hero-scene.js').then((module) => module.initHeroScene(mount))
  }
</script>