---
const { num, title, lead } = Astro.props
---

<div class="mb-10 md:mb-14" data-reveal>
  <div class="flex items-center gap-4">
    <span class="font-mono text-sm text-accent">{num}</span>
    <h2 class="text-2xl font-bold tracking-tight md:text-[2rem]">{title}</h2>
    <span
      aria-hidden="true"
      class="h-px flex-1 bg-gradient-to-r from-primary/30 to-transparent"></span>
  </div>
  {
    lead && (
      <p class="mt-3 max-w-[560px] text-sm text-base-content/60 md:text-base">{lead}</p>
    )
  }
</div>