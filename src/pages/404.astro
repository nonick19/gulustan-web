---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout
  lang="tr"
  title="Sayfa bulunamadı — Ali Gülüstan"
  description="Aradığınız sayfa bulunamadı."
  path="/404/"
>
  <main class="flex min-h-screen items-center justify-center">
    <div class="shell max-w-[560px] text-center">
      <p class="font-mono text-sm text-accent">404</p>
      <h1 class="mt-3 text-3xl font-bold">Sayfa bulunamadı</h1>
      <p class="mt-4 leading-relaxed text-base-content/60">
        Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir. Ana sayfadan devam edebilirsiniz.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-primary">Ana sayfa</a>
        <a href="/en/" class="btn btn-outline btn-secondary">English home</a>
      </div>
    </div>
  </main>
</BaseLayout>