---
import { getCollection } from 'astro:content'
import BlogIndex from '../../components/BlogIndex.astro'

const posts = (await getCollection('blog', ({ data }) => data.lang === 'tr')).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() || a.data.title.localeCompare(b.data.title, 'tr'),
)
---

<BlogIndex lang="tr" posts={posts} />